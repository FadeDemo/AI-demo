{
  "python-envs.workspaceSearchPaths": [
    "./projects/engineering-foundations/.venv"
  ],
  "python-envs.pythonProjects": [
    {
      "path": "projects/engineering-foundations",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ],
  "python.terminal.executeInFileDir": false,
  "terminal.integrated.cwd": "${workspaceFolder}/projects/engineering-foundations",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/projects/engineering-foundations/src"
  ],
  "pylint.interpreter": [
    "${workspaceFolder}/projects/engineering-foundations/.venv/bin/python"
  ],
  "autopep8.interpreter": [
    "${workspaceFolder}/projects/engineering-foundations/.venv/bin/python"
  ],
  "isort.interpreter": [
    "${workspaceFolder}/projects/engineering-foundations/.venv/bin/python"
  ],
  "python.testing.cwd": "${workspaceFolder}/projects/engineering-foundations",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "tests",
    "-p",
    "test_*.py"
  ],
  "pylint.cwd": "${workspaceFolder}/projects/engineering-foundations",
  "python.useEnvironmentsExtension": true,
  "python.terminal.activateEnvironment": true
}
