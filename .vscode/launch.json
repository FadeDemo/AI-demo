{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 当前文件（课程环境）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/projects/llm-terminal-assistant",
      "python": "${workspaceFolder}/projects/llm-terminal-assistant/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "Python: 调试测试（课程环境）",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/projects/llm-terminal-assistant",
      "python": "${workspaceFolder}/projects/llm-terminal-assistant/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/projects/llm-terminal-assistant/src",
        "PROJECT_ROOT_PATH": "${workspaceFolder}/projects/llm-terminal-assistant"
      },
      "justMyCode": true
    }
  ]
}
