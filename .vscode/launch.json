{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 当前文件（课程环境）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/projects/rag-knowledge-base",
      "python": "${workspaceFolder}/projects/rag-knowledge-base/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "Python: 调试测试（课程环境）",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/projects/rag-knowledge-base",
      "python": "${workspaceFolder}/projects/rag-knowledge-base/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/projects/rag-knowledge-base/src",
        "PROJECT_ROOT_PATH": "${workspaceFolder}/projects/rag-knowledge-base"
      },
      "justMyCode": true
    }
  ]
}
