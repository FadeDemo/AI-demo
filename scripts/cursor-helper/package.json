{
  "name": "use-venv-helper",
  "displayName": "use-venv Helper",
  "description": "Local workspace automation for use-venv",
  "version": "0.1.0",
  "publisher": "ai-demo-local",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "use-venv.restoreTerminalActivation",
        "title": "use-venv: Restore Python Terminal Activation"
      }
    ]
  }
}
